# --- Supabase (cloud free tier: Project Settings → API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server/worker only — never ship to the app or browser

# --- Next.js web (hospital + admin) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Expo mobile app ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_ACCESS_TOKEN=                # optional, for push security

# --- Data sources ---
FIRMS_MAP_KEY=                    # free: https://firms.modaps.eosdis.nasa.gov/api/map_key/
WAQI_TOKEN=                       # free: https://aqicn.org/data-platform/token/ (measured air quality)
# Replace the contact with a real email or URL: Nominatim refuses (403) the placeholder, and
# the worker then skips geocoding and uses approximate station coordinates.
NOMINATIM_USER_AGENT=JagaSekitar-Hackathon/1.0 (your-email@example.com)
OSRM_BASE_URL=https://router.project-osrm.org
DEFAULT_STATE=PRK

# --- Demo accounts (used by `npm run seed:accounts`; pick your own test passwords) ---
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_EMAIL=
DEMO_STAFF_PASSWORD=
DEMO_STAFF_FACILITY=Hospital Raja Permaisuri Bainun

# --- Worker behaviour ---
USE_MOCKS=false                   # true = skip live sources, always use mock.json fallbacks

# --- AI briefing agent (worker only; never in Vercel or the app) ---
# Any OpenAI-compatible API. Default: NVIDIA (build.nvidia.com, free credits).
NVIDIA_API_KEY=
# AI_API_KEY=              # instead of NVIDIA_API_KEY for another provider
# AI_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_MODEL=openai/gpt-oss-20b
