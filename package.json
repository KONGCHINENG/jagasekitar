{
  "name": "jagasekitar",
  "private": true,
  "version": "0.1.0",
  "description": "JagaSekitar — multi-hazard (haze, flood, disease) early warning for Malaysia",
  "workspaces": [
    "apps/*",
    "packages/*",
    "worker",
    "supabase"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @jagasekitar/web",
    "dev:mobile": "npm run start -w @jagasekitar/mobile",
    "worker:once": "npm run once -w @jagasekitar/worker",
    "worker:dev": "npm run dev -w @jagasekitar/worker",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint -w @jagasekitar/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:db": "npm run test -w @jagasekitar/db",
    "seed:accounts": "npm run seed:accounts -w @jagasekitar/worker",
    "seed:districts": "npm run seed:districts -w @jagasekitar/worker",
    "db:push": "supabase db push --workdir . --include-seed",
    "predict": "npm run predict -w @jagasekitar/worker"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
